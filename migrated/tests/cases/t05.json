      "test_id": "T05-TSQL-01-1",
      "job_id": "T05",
      "trap_id": "TSQL-01",
      "description": "Open-book filter with mixed-case status values. Claims 1 and 2 use the canonical 'OPEN' and 'REOPENED'. Claims 3, 4 and 5 hold 'Open', 'reopened' and 'ReOpened'; the case-insensitive collation keeps them in the open book. Claim 6 is 'CLOSED' and is excluded either way. A naive Spark isin(['OPEN','REOPENED']) is case-sensitive, so it would drop claims 3-5 and their payments.",
      "inputs": [
        {
          "table": "stg.claims",
          "columns": [
            "claim_id",
            "claim_number",
            "policy_id",
            "customer_id",
            "lob_code",

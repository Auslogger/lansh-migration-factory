  "cases": [
    {
      "test_id": "T06-TSQL-04-1",
      "job_id": "T06",
      "trap_id": "TSQL-04",
      "description": "Payments that cross a calendar-year boundary after less than a full year has passed since the loss. For example, a loss on 2023-12-31 paid on 2024-01-01, a loss on 2022-12-15 paid on 2023-06-10, a loss on 2021-11-30 paid on 2023-02-01, a loss on 2024-12-20 paid on 2025-01-05, and a loss on 2019-06-30 paid on 2025-06-01. DATEDIFF(YEAR) counts calendar-year boundaries crossed, so it puts these payments one development year later than a translation based on full years elapsed (months_between or day counts). Those payments would land in the wrong dev_n and cumulative_n cells, or in the wrong row. Control payments where both methods give the same development year are included too (same-year payments, and payments past the loss anniversary).",
      "inputs": [
        {
          "table": "stg.claims",
          "columns": [
            "claim_id",
            "claim_number",
            "policy_id",

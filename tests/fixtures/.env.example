# Copy to .env at the repo root (make setup does this) and fill in the password.
# .env is gitignored; never commit a real value.

# SQL Server 2022 sa password (compose.yaml); 8+ chars with upper, lower, digit and symbol
MSSQL_SA_PASSWORD=

# Optional overrides (defaults shown)
# LANSH_MSSQL_HOST=localhost
# LANSH_MSSQL_PORT=1433
# LANSH_MSSQL_USER=sa
# LANSH_JAVA_HOME=/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home
# LANSH_CLAUDE_BIN=claude
# LANSH_LLM_MAX_LIVE_CALLS=150
# LANSH_SAS_CFGNAME=oda

  "job": {
    "name": "X1.usp_broker_production",
    "namespace": "lansh"
  },
  "outputs": [
    {
      "facets": {
        "columnLineage": {
          "_producer": "https://github.com/Auslogger/Agentic-Data-Platform-Modernisation",
          "_schemaURL": "https://openlineage.io/spec/facets/1-2-0/ColumnLineageDatasetFacet.json",
          "fields": {
            "broker_code": {
              "inputFields": [
                {
                  "field": "broker_code",
                  "name": "bronze.policy_snapshots",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "ISNULL(UPPER(LTRIM(RTRIM(broker_code))),'DIRECT'), passed through the union of keys",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            },
            "broker_name": {
              "inputFields": [
                {
                  "field": "broker_name",
                  "name": "bronze.brokers",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "LEFT JOIN lookup on broker_code",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            },
            "broker_status": {
              "inputFields": [
                {
                  "field": "status",
                  "name": "bronze.brokers",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "UPPER(RTRIM(status))",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            },
            "claims_paid_eur": {
              "inputFields": [
                {
                  "field": "amount",
                  "name": "bronze.claim_payments",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "SUM(ISNULL(amount,0)), CAST DECIMAL(14,2), ISNULL 0",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            },
            "gwp_eur": {
              "inputFields": [
                {
                  "field": "amount",
                  "name": "bronze.premium_transactions",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "SUM(amount * fx rate), CAST DECIMAL(14,2), ISNULL 0",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                },
                {
                  "field": "currency",
                  "name": "bronze.premium_transactions",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "CASE WHEN currency='EUR' THEN 1 ELSE rate_to_eur",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                },
                {
                  "field": "rate_to_eur",
                  "name": "bronze.fx_rates",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "multiplier for amounts not in EUR (latest rate on or before txn_date)",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            },
            "lob_code": {
              "inputFields": [
                {
                  "field": "lob_code",
                  "name": "bronze.products",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "UPPER(RTRIM(p.lob_code)) from the product of the latest snapshot",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            },
            "paid_to_written": {
              "inputFields": [
                {
                  "field": "amount",
                  "name": "bronze.claim_payments",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "broker-level SUM(paid) / NULLIF(SUM(gwp),0), DECIMAL(12,4)",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                },
                {
                  "field": "amount",
                  "name": "bronze.premium_transactions",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "denominator: broker-level SUM(gwp_eur)",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                },
                {
                  "field": "currency",
                  "name": "bronze.premium_transactions",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "EUR check in the gwp conversion",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                },
                {
                  "field": "rate_to_eur",
                  "name": "bronze.fx_rates",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "fx conversion in the gwp denominator",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            },
            "review_flag": {
              "inputFields": [
                {
                  "field": "amount",
                  "name": "bronze.claim_payments",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "CASE WHEN paid_to_written > 0.75 THEN 'Y' ELSE 'N'",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                },
                {
                  "field": "amount",
                  "name": "bronze.premium_transactions",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "via the paid_to_written ratio > 0.75",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                },
                {
                  "field": "currency",
                  "name": "bronze.premium_transactions",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "via the gwp conversion in the ratio",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                },
                {
                  "field": "rate_to_eur",
                  "name": "bronze.fx_rates",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "via the gwp conversion in the ratio",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            }
          }
        },
        "schema": {
          "_producer": "https://github.com/Auslogger/Agentic-Data-Platform-Modernisation",
          "_schemaURL": "https://openlineage.io/spec/facets/1-1-1/SchemaDatasetFacet.json",
          "fields": [
            {
              "name": "as_of_date",
              "type": "date"
            },
            {
              "name": "broker_code",
              "type": "string"
            },
            {
              "name": "broker_name",
              "type": "string"
            },
            {
              "name": "broker_status",
              "type": "string"
            },
            {
              "name": "lob_code",
              "type": "string"
            },
            {
              "name": "policies_in_force",
              "type": "int"
            },
            {
              "name": "gwp_eur",
              "type": "decimal(14,2)"
            },
            {
              "name": "claims_notified",
              "type": "int"
            },
            {
              "name": "claims_paid_eur",
              "type": "decimal(14,2)"
            },
            {
              "name": "paid_to_written",
              "type": "decimal(12,4)"
            },
            {
              "name": "review_flag",
              "type": "string"
            }
          ]
        }
      },

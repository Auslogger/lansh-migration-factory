                    {
                      "description": "direct copy via #open_claims",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            },
            "claim_number": {
              "inputFields": [
                {
                  "field": "claim_number",
                  "name": "bronze.claims",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "direct copy via #open_claims",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            },
            "claim_ref": {
              "inputFields": [
                {
                  "field": "lob_code",
                  "name": "bronze.claims",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "UPPER(RTRIM(lob_code)) + '/' + claim_number + '/' + handler_code",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                },
                {
                  "field": "claim_number",
                  "name": "bronze.claims",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "lob_code + '/' + claim_number + '/' + handler_code",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                },
                {
                  "field": "handler_code",
                  "name": "bronze.claims",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "lob_code + '/' + claim_number + '/' + handler_code (NULL handler gives NULL ref)",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            },
            "current_reserve": {
              "inputFields": [
                {
                  "field": "reserve_amount",
                  "name": "bronze.claim_reserves",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "indemnity_reserve + expense_reserve",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                },
                {
                  "field": "reserve_type",
                  "name": "bronze.claim_reserves",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "CASE pivot by reserve_type feeding the sum",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            },
            "days_open": {
              "inputFields": [
                {
                  "field": "reported_date",
                  "name": "bronze.claims",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "DATEDIFF(DAY, reported_date, @AsOfDate)",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            },
            "expense_reserve": {
              "inputFields": [
                {
                  "field": "reserve_amount",
                  "name": "bronze.claim_reserves",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "ISNULL(MAX(CASE WHEN reserve_type='EXPENSE' THEN reserve_amount END),0)",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                },
                {
                  "field": "reserve_type",
                  "name": "bronze.claim_reserves",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "CASE WHEN reserve_type='EXPENSE'",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]

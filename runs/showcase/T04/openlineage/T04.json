              "inputFields": [
                {
                  "field": "lob_code",
                  "name": "bronze.claims",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "UPPER(RTRIM(lob_code))",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            },

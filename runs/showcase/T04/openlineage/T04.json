              "inputFields": [
                {
                  "field": "amount",
                  "name": "bronze.claim_payments",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "total_paid + indemnity_reserve + expense_reserve",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                },
                {
                  "field": "reserve_amount",
                  "name": "bronze.claim_reserves",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "total_paid + indemnity_reserve + expense_reserve",

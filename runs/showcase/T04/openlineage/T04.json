                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            },
            "indemnity_reserve": {
              "inputFields": [
                {
                  "field": "reserve_amount",
                  "name": "bronze.claim_reserves",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "ISNULL(MAX(CASE WHEN reserve_type='INDEMNITY' THEN reserve_amount END),0)",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                },
                {
                  "field": "reserve_type",
                  "name": "bronze.claim_reserves",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "CASE WHEN reserve_type='INDEMNITY'",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            },

  "job": {
    "name": "S04.risk_scoring.sas",
    "namespace": "lansh"
  },
  "outputs": [
    {
      "facets": {
        "columnLineage": {
          "_producer": "https://github.com/Auslogger/Agentic-Data-Platform-Modernisation",
          "_schemaURL": "https://openlineage.io/spec/facets/1-2-0/ColumnLineageDatasetFacet.json",
          "fields": {
            "age": {
              "inputFields": [
                {
                  "field": "date_of_birth",
                  "name": "silver.dim_customer",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "int((&as_of - date_of_birth)/365.25)",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            },
            "age_load": {
              "inputFields": [
                {
                  "field": "date_of_birth",
                  "name": "silver.dim_customer",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "age banding: <25 gives 1.40, >=70 gives 1.25, else 1.00",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            },
            "county_load": {
              "inputFields": [
                {
                  "field": "county",
                  "name": "silver.dim_customer",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "SELECT on UPCASE(STRIP(county)): DUBLIN 1.15; CORK/LIMERICK/GALWAY 1.05; else 1.00",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            },
            "customer_id": {
              "inputFields": [
                {
                  "field": "customer_id",
                  "name": "silver.claims_enriched",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "group key, passed through the per-line score tables and the union",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            },
            "lob_code": {
              "inputFields": [
                {
                  "field": "lob_code",
                  "name": "silver.claims_enriched",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "group key, passed through",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            },
            "loss_ratio": {
              "inputFields": [
                {
                  "field": "total_paid",
                  "name": "silver.claims_enriched",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "SUM(paid) per line / earned",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                },
                {
                  "field": "earned_eur",
                  "name": "gold.premium_band_summary",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "denominator SUM(earned_eur) per lob_code",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            },
            "n_claims": {
              "inputFields": [
                {
                  "field": "customer_id",
                  "name": "silver.claims_enriched",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "COUNT(*) of claim rows per customer_id, lob_code",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            },
            "n_recoveries": {
              "inputFields": [
                {
                  "field": "n_recoveries",
                  "name": "silver.claims_enriched",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "SUM(n_recoveries) per customer and line",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            },
            "paid": {
              "inputFields": [
                {
                  "field": "total_paid",
                  "name": "silver.claims_enriched",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "SUM(total_paid) per customer and line",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            },
            "points": {
              "inputFields": [
                {
                  "field": "customer_id",
                  "name": "silver.claims_enriched",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "12.5*min(n_claims,4), where n_claims = COUNT(*)",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                },
                {
                  "field": "n_recoveries",
                  "name": "silver.claims_enriched",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "7.5*n_recoveries",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                },
                {
                  "field": "total_paid",
                  "name": "silver.claims_enriched",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "sev_points from severity bands, plus lob_points from loss_ratio",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                },
                {
                  "field": "earned_eur",
                  "name": "gold.premium_band_summary",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "lob_points=round(2.5*loss_ratio,0.5)",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            },
            "score": {
              "inputFields": [
                {
                  "field": "customer_id",
                  "name": "silver.claims_enriched",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "through points (n_claims count)",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                },
                {
                  "field": "n_recoveries",
                  "name": "silver.claims_enriched",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "through points",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                },
                {
                  "field": "total_paid",
                  "name": "silver.claims_enriched",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "through points (severity, loss_ratio)",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                },
                {
                  "field": "earned_eur",
                  "name": "gold.premium_band_summary",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "through points (loss_ratio)",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                },
                {
                  "field": "date_of_birth",
                  "name": "silver.dim_customer",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "round(points*age_load*county_load,0.01)",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                },
                {
                  "field": "county",
                  "name": "silver.dim_customer",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "through county_load",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            },
            "severity": {
              "inputFields": [
                {
                  "field": "total_paid",
                  "name": "silver.claims_enriched",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "paid / MEAN(paid) remerged over the line's rows",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                },
                {
                  "field": "lob_code",
                  "name": "silver.claims_enriched",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "which line's rows the mean is taken over (one table per line)",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            },
            "tier": {
              "inputFields": [
                {
                  "field": "customer_id",
                  "name": "silver.claims_enriched",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "score bands, through n_claims count",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                },
                {
                  "field": "n_recoveries",
                  "name": "silver.claims_enriched",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "score>=35 HIGH, >=22 MEDIUM, else LOW",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                },
                {
                  "field": "total_paid",
                  "name": "silver.claims_enriched",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "through score",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                },
                {
                  "field": "earned_eur",
                  "name": "gold.premium_band_summary",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "through score",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                },
                {
                  "field": "date_of_birth",
                  "name": "silver.dim_customer",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "through score",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                },
                {
                  "field": "county",
                  "name": "silver.dim_customer",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "through score",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            }
          }
        },

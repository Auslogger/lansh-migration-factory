                    }
                  ]
                }
              ]
            },
            "claim_status": {
              "inputFields": [
                {
                  "field": "status",
                  "name": "bronze.claims",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "UPPER(LTRIM(RTRIM(status)))",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            },
            "closed_date": {
              "inputFields": [
                {
                  "field": "closed_date",
                  "name": "bronze.claims",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "direct via #clm",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            },
            "days_since_last_activity": {
              "inputFields": [
                {
                  "field": "payment_date",
                  "name": "bronze.claim_payments",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "MAX payment_date (non-null amount) vs last reserve date, greatest, DATEDIFF to @AsOfDate",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                },
                {
                  "field": "amount",
                  "name": "bronze.claim_payments",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "only payments with amount IS NOT NULL count for last_payment_date",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                },
                {
                  "field": "reserve_date",
                  "name": "bronze.claim_reserves",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "MAX(reserve_date) as last_reserve_date",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            },
            "incurred_90d_ago": {
              "inputFields": [
                {
                  "field": "amount",
                  "name": "bronze.claim_payments",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "paid_prior + os_prior",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                },
                {
                  "field": "payment_date",
                  "name": "bronze.claim_payments",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "CASE WHEN payment_date <= @PriorDate THEN amount",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                },
                {
                  "field": "reserve_amount",
                  "name": "bronze.claim_reserves",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "latest reserve as at @AsOfDate-90 summed (os_prior)",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            },
            "incurred_amount": {
              "inputFields": [
                {
                  "field": "amount",
                  "name": "bronze.claim_payments",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "paid_now + os_now",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                },
                {
                  "field": "reserve_amount",
                  "name": "bronze.claim_reserves",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "paid_now + os_now",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            },
            "lob_code": {
              "inputFields": [
                {
                  "field": "lob_code",
                  "name": "bronze.claims",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "UPPER(LTRIM(RTRIM(lob_code)))",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            },
            "movement_90d": {
              "inputFields": [
                {
                  "field": "amount",
                  "name": "bronze.claim_payments",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "incurred_amount - incurred_90d_ago",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                },
                {
                  "field": "payment_date",
                  "name": "bronze.claim_payments",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "prior-period split of payments",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                },
                {
                  "field": "reserve_amount",
                  "name": "bronze.claim_reserves",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "os_now - os_prior",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            },
            "outstanding_reserve": {
              "inputFields": [
                {
                  "field": "reserve_amount",
                  "name": "bronze.claim_reserves",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "SUM of latest reserve_amount per claim (and reserve_type) as at @AsOfDate, ISNULL 0",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            },
            "paid_to_date": {
              "inputFields": [
                {
                  "field": "amount",
                  "name": "bronze.claim_payments",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "ISNULL(SUM(ISNULL(amount,0)),0) for payment_date <= @AsOfDate",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            },
            "policy_id": {
              "inputFields": [
                {
                  "field": "policy_id",
                  "name": "bronze.claims",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "direct via #clm",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            },
            "reported_date": {
              "inputFields": [
                {
                  "field": "reported_date",
                  "name": "bronze.claims",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "direct via #clm",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            },
            "reserve_changes_90d": {
              "inputFields": [
                {
                  "field": "reserve_date",
                  "name": "bronze.claim_reserves",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "SUM(CASE WHEN reserve_date > @PriorDate THEN 1 ELSE 0 END), ISNULL 0",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                }
              ]
            },
            "watch_category": {
              "inputFields": [
                {
                  "field": "amount",
                  "name": "bronze.claim_payments",
                  "namespace": "lansh-lakehouse",
                  "transformations": [
                    {
                      "description": "CASE on incurred vs incurred_90d_ago",
                      "subtype": "TRANSFORMATION",
                      "type": "DIRECT"
                    }
                  ]
                },
                {
                  "field": "payment_date",

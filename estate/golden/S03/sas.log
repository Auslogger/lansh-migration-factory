1659       /******************************************************************************
1660         Program  : premium_bands.sas
1661         Purpose  : Written and earned premium by line of business and premium band
1662                    for the pricing committee. Each policy is banded once, on the
1663                    premium of its first transaction as loaded, and all of its
1664                    transactions are reported in that band.
1665         Inputs   : dw.fact_premium_earned
1666         Output   : rpt.premium_band_summary (rebuilt on every run)
1667         Params   : as_of - reporting date (SAS date), set by the scheduler
1668         Author   : RN
1669       
1670         Change log
1671           2016-02-22  RN    Initial version
1672           2017-05-08  RN    Top band split: 1000 and over (CR-1077)
1673           2019-10-14  CB    Transactions reported in their policy's band, not their
1674                             own (CR-1520)
1675           2022-03-07  CB    Policy count per band (CR-1951)
1676       ******************************************************************************/
1677       
1678       /* premium bands used by pricing since 2017 */
1679       proc format;
1680         value premband
1681           low  -< 0    = 'NEGATIVE'
1682           0    -< 250  = '0-249'
1683           250  -< 500  = '250-499'
1684           500  -< 1000 = '500-999'
1685           1000 - high  = '1000+'
1686           other        = 'UNKNOWN';
NOTE: Format PREMBAND has been output.
1687       run;


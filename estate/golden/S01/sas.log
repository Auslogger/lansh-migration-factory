623        
624        /* enrich the register: every claim is reported, paid or not */
625        data dw.claims_enriched(keep=claim_id claim_number policy_id customer_id lob_code
626                                     loss_date reported_date status n_payments n_recoveries
627                                     total_paid indemnity_amt expense_amt recovery_amt gross_paid
628                                     net_paid first_payment_date last_payment_date recovery_flag
629                                     has_payment);
630          merge work.claims(in=c) work.pay_summary(in=p);
631          by claim_id;
632          if c;
633        
634          lob_code = upcase(strip(lob_code));
635          status   = upcase(strip(status));
636        
637          has_payment = p;
638          if not p then do;
639            n_payments    = 0;
640            n_recoveries  = 0;
641            total_paid    = 0;
642            recovery_flag = 0;
643          end;
644        
645          gross_paid = indemnity_amt + expense_amt;
646          net_paid   = sum(indemnity_amt, expense_amt, recovery_amt);
647        run;


541        options mprint;
542        %let as_of = '31DEC2025'd;
543        /******************************************************************************
544          Program  : claims_enrich.sas
545          Purpose  : Claim-level payment history for the risk team. One row per claim
546                     on the claims register with its payments up to the reporting
547                     date: payment and recovery counts, paid to date, the paid split
548                     by payment type (gross, and net of recoveries), the first and
549                     last payment dates and a recovery marker. Read by the customer
550                     risk scoring (risk_scoring.sas).
551          Inputs   : stg.claims, stg.claim_payments
552          Output   : dw.claims_enriched (rebuilt on every run)
553          Params   : as_of - reporting date (SAS date), set by the scheduler
554          Author   : DOS
555        
556          Change log
557            2014-03-10  DOS   Initial version
558            2015-08-24  DOS   Recoveries counted and flagged for the subrogation desk
559                              (CR-0611)
560            2017-01-16  AK    Paid split by payment type; gross and net paid (CR-1042)
561            2018-11-05  AK    Payments dated after the reporting date left out
562                              (INC-1677)
563            2019-09-30  AK    Line of business and status tidied for the MI pack
564                              (CR-1502)
565            2021-06-14  SMcC  Claims with nothing paid yet kept, with has_payment, for
566                              risk_scoring.sas (CR-1873)
567        ******************************************************************************/
568        
569        /* claims register */
570        proc sort data=stg.claims(keep=claim_id claim_number policy_id customer_id lob_code
571                                       loss_date reported_date status)
572                  out=work.claims;
573          by claim_id;
574        run;


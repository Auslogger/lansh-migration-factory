582        
583        /* roll the payments up to one row per claim */
584        data work.pay_summary(keep=claim_id n_payments n_recoveries total_paid indemnity_amt
585                                   expense_amt recovery_amt first_payment_date last_payment_date
586                                   recovery_flag);
587          set work.payments;
588          by claim_id;
589          length ptype $12;
590          retain n_payments n_recoveries total_paid indemnity_amt expense_amt recovery_amt
591                 first_payment_date last_payment_date recovery_flag;
592          format first_payment_date last_payment_date date9.;
593        
594          if first.claim_id then do;
595            n_payments    = 0;
596            n_recoveries  = 0;
597            total_paid    = 0;
598            indemnity_amt = 0;
599            expense_amt   = 0;
600            recovery_amt  = 0;
601            recovery_flag = 0;
602            first_payment_date = payment_date;
603          end;
604        
605          n_payments + 1;
606          total_paid + amount;
607        
608          /* paid split by payment type (keyed in mixed case) */
609          ptype = upcase(strip(payment_type));
610          if ptype = 'INDEMNITY' then indemnity_amt = indemnity_amt + amount;
611          else if ptype = 'EXPENSE' then expense_amt = expense_amt + amount;
612          else if ptype = 'RECOVERY' then recovery_amt = recovery_amt + amount;
613        
614          /* recoveries (salvage, third-party) come through as negative amounts */
615          if amount < 0 then do;
616            recovery_flag = 1;
617            n_recoveries + 1;
618          end;
619        
620          last_payment_date = payment_date;
621          if last.claim_id then output;
622        run;


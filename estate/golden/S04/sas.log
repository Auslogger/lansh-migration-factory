2680       /* each customer against the average for the line */
2681       %macro score_lines(lobs);
2682         %local i lob;
2683         %do i = 1 %to %sysfunc(countw(&lobs));
2684           %let lob = %scan(&lobs, &i);
2685           proc sql;
2686             create table work.score_&lob as
2687             select x.customer_id, x.lob_code, x.n_claims, x.paid, x.n_recoveries,
2688                    x.paid / mean(x.paid) as severity
2689             from   work.experience x
2690             where  x.lob_code = "&lob";
2691           quit;
2692         %end;
2693       %mend score_lines;

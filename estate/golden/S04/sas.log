2620       options mprint;
2621       %let as_of = '31DEC2025'd;
2622       /******************************************************************************
2623         Program  : risk_scoring.sas
2624         Purpose  : Customer risk score and referral tier by line of business for
2625                    underwriting. Claims experience (claim count, recoveries and
2626                    severity against the line's average) plus the line's loss ratio,
2627                    loaded for the policyholder's age and county.
2628         Inputs   : dw.claims_enriched, rpt.premium_band_summary, dw.dim_customer
2629         Output   : rpt.risk_scores (rebuilt on every run)
2630         Params   : as_of - reporting date (SAS date), set by the scheduler
2631         Author   : TF
2632       
2633         Change log
2634           2015-06-02  TF    Initial version (motor only)
2635           2016-11-21  TF    Home and travel added; scoring per line in a macro
2636                             (CR-0998)
2637           2018-04-09  GH    Age and county loadings from the pricing review (CR-1302)
2638           2020-01-27  GH    Line loss ratio from premium_bands.sas (CR-1544)
2639           2022-09-12  TF    Referral tiers for the underwriting queue (CR-2011)
2640       ******************************************************************************/
2641       
2642       /* policyholder loadings: age at the reporting date and county */
2643       data work.cust(keep=customer_id age age_load county_load);
2644         set dw.dim_customer(keep=customer_id date_of_birth county);
2645         age = int((&as_of - date_of_birth) / 365.25);
2646         if missing(age) then age_load = 1.00;
2647         else if age < 25 then age_load = 1.40;
2648         else if age >= 70 then age_load = 1.25;
2649         else age_load = 1.00;
2650         select (upcase(strip(county)));
2651           when ('DUBLIN') county_load = 1.15;
2652           when ('CORK', 'LIMERICK', 'GALWAY') county_load = 1.05;
2653           otherwise county_load = 1.00;
2654         end;
2655       run;


2709       
2710       /* points, loadings and the referral tier */
2711       data rpt.risk_scores(keep=customer_id lob_code n_claims paid n_recoveries severity age
2712                                 age_load county_load loss_ratio points score tier as_of_date);
2713         set work.scoring;
2714         sev_points = 0;
2715         if severity >= 2 then sev_points = 10;
2716         else if severity >= 1 then sev_points = 5;
2717         lob_points = round(2.5 * loss_ratio, 0.5);
2718         points = 12.5 * min(n_claims, 4) + 7.5 * n_recoveries + sev_points + lob_points;
2719         score  = round(points * age_load * county_load, 0.01);
2720         if score >= 35 then tier = 'HIGH';
2721         else if score >= 22 then tier = 'MEDIUM';
2722         else tier = 'LOW';
2723         format as_of_date yymmdd10.;
2724         as_of_date = &as_of;
2725       run;

